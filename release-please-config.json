{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='assetboard')].version"
        },
        {
          "type": "generic",
          "path": "docs/deployment.md"
        },
        {
          "type": "generic",
          "path": "deploy/podman/assetboard.container"
        }
      ]
    }
  }
}
