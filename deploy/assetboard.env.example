# AssetBoard settings for a native install. The install script copies this file to
# /etc/assetboard/assetboard.env (owner root, group assetboard, mode 0640) and never overwrites it.
# Every setting is listed in docs/deployment.md#environment-variables.
# Format: KEY=value, one per line. Wrap values that contain spaces in double quotes.
# ASSETBOARD_ENV and ASSETBOARD_DATA_DIR are set in the systemd unit.

# The URL people use to open the app (behind your reverse proxy).
ASSETBOARD_BASE_URL=http://localhost:8000

# Your reverse proxy's IP or CIDR. 127.0.0.1 when the proxy runs on this machine.
ASSETBOARD_TRUSTED_PROXIES=127.0.0.1

ASSETBOARD_DEFAULT_LOCALE=en
ASSETBOARD_DEFAULT_CURRENCY=EUR
ASSETBOARD_LOG_FORMAT=text
ASSETBOARD_AUTO_MIGRATE=true

# Optional: a fixed first-run setup token (at least 22 random characters). If unset, a token is
# printed once in the journal at each start while no user exists.
#ASSETBOARD_SETUP_TOKEN=

# Optional: OIDC sign-in; see docs/auth/oidc.md.
#ASSETBOARD_OIDC_ISSUER=
#ASSETBOARD_OIDC_CLIENT_ID=
#ASSETBOARD_OIDC_CLIENT_SECRET=
#ASSETBOARD_OIDC_SCOPES="openid email profile"
