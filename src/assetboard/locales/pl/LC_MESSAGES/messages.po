msgstr "Twoje konto"

msgid "Personal workspace"
msgstr "Przestrzeń osobista"

msgid "Account security"
msgstr "Bezpieczeństwo konta"

msgid "Sign out"
msgstr "Wyloguj się"

msgid "Toggle dark mode"
msgstr "Przełącz tryb ciemny"

msgid "Personal finance"
msgstr "Finanse osobiste"

msgid "Your overview"
msgstr "Podsumowanie"

msgid "Workspace"
msgstr "Przestrzeń"

msgid "Personal"
msgstr "Osobista"

msgid "Are you sure?"
msgstr "Czy na pewno?"

msgid "This action cannot be undone."
msgstr "Tej operacji nie można cofnąć."

msgid "Continue"
msgstr "Kontynuuj"

msgid "Cancel"
msgstr "Anuluj"

msgid "Overview"
msgstr "Podsumowanie"

msgid "Monthly summary"
msgstr "Podsumowanie miesiąca"

msgid "Income"
msgstr "Przychody"

msgid "Planned and actual amounts will appear here."
msgstr "Zaplanowane i rzeczywiste kwoty pojawią się tutaj."

msgid "Expenses"
msgstr "Wydatki"

msgid "Keep your monthly spending in view."
msgstr "Śledź miesięczne wydatki."

msgid "Available"
msgstr "Pozostało"

msgid "Income minus regular expenses."
msgstr "Przychody pomniejszone o regularne wydatki."

msgid "Nothing to show yet"
msgstr "Na razie brak danych"

msgid ""
"Your monthly plan and activity will appear here once you start adding "
"items."
msgstr ""
"Twój plan miesięczny i aktywność pojawią się tutaj, gdy dodasz pierwsze "
"pozycje."

msgid "Sign in"
msgstr "Zaloguj się"

msgid "Email"
msgstr "E-mail"

msgid "Password"
msgstr "Hasło"

msgid "No account yet?"
msgstr "Nie masz jeszcze konta?"

msgid "Create an account"
msgstr "Utwórz konto"

msgid "Change password"
msgstr "Zmień hasło"

msgid "Current password"
msgstr "Obecne hasło"

msgid "New password"
msgstr "Nowe hasło"

msgid "At least 10 characters. Common passwords are not accepted."
msgstr "Co najmniej 10 znaków. Popularne hasła nie są akceptowane."

msgid "Repeat the new password"
msgstr "Powtórz nowe hasło"

msgid "Other devices"
msgstr "Inne urządzenia"

msgid "Sign out everywhere except on this device."
msgstr "Wyloguj się wszędzie poza tym urządzeniem."

msgid "Sign out other devices"
msgstr "Wyloguj inne urządzenia"

msgid "Display name"
msgstr "Wyświetlana nazwa"

msgid "Workspace name"
msgstr "Nazwa obszaru roboczego"

msgid "Create account"
msgstr "Utwórz konto"

msgid "Already have an account?"
msgstr "Masz już konto?"

msgid "First-run setup"
msgstr "Konfiguracja początkowa"

msgid ""
"Create the administrator account and the first workspace. The setup token"
" is printed once in the application log at startup, unless you set "
"ASSETBOARD_SETUP_TOKEN."
msgstr ""
"Utwórz konto administratora i pierwszy obszar roboczy. Token konfiguracji"
" jest jednorazowo wypisywany w dzienniku aplikacji podczas uruchamiania, "
"chyba że ustawiono ASSETBOARD_SETUP_TOKEN."

msgid "Setup token"
msgstr "Token konfiguracji"

msgid "Administrator"
msgstr "Administrator"

msgid "Defaults to your display name."
msgstr "Domyślnie Twoja wyświetlana nazwa."

msgid "Base currency"
msgstr "Waluta podstawowa"

msgid "Country"
msgstr "Kraj"

msgid "Not set"
msgstr "Nie ustawiono"

msgid "Time zone"
msgstr "Strefa czasowa"

msgid "Language"
msgstr "Język"

msgid "Create administrator"
msgstr "Utwórz administratora"

msgid "Dismiss"
msgstr "Zamknij"

msgid "Return to overview"
msgstr "Powrót do podsumowania"

